{
  "name": "@app/ai-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ai-service: gRPC ai.v1 AiService (conversations, the chat turn and its server-streamed variant, read-only tools over identity-, notifications- and billing-service) on Postgres through @platform/ai (OpenRouter); HTTP only for /health and /metrics.",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=../../.env --env-file-if-exists=.env --enable-source-maps --conditions=@repo/source --import @swc-node/register/esm-register --import ./src/instrument.ts src/main.ts",
    "start:dev": "bun run dev",
    "g": "sh -c 'nest g \"$@\" && eslint --fix src' nest-g",
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import ./dist/instrument.js dist/main.js",
    "start:prod": "node --import ./dist/instrument.js dist/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/migrate.js",
    "db:migrate:dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --conditions=@repo/source --import @swc-node/register/esm-register src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project ai-service",
    "test:e2e": "vitest run --config ../../vitest.config.ts --project ai-service:e2e",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@domain/ai": "workspace:*",
    "@domain/ai-contracts": "workspace:*",
    "@domain/billing": "workspace:*",
    "@domain/billing-contracts": "workspace:*",
    "@domain/identity": "workspace:*",
    "@domain/identity-contracts": "workspace:*",
    "@domain/notifications": "workspace:*",
    "@domain/notifications-contracts": "workspace:*",
    "@platform/ai": "workspace:*",
    "@platform/auth": "workspace:*",
    "@platform/bootstrap": "workspace:*",
    "@platform/common": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/database": "workspace:*",
    "@platform/observability": "workspace:*",
    "@platform/transport": "workspace:*",
    "@fastify/static": "catalog:",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@platform/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
