# ai-service — app-specific overrides only. Shared settings (DATABASE_URL, AI_* / OPENROUTER_API_KEY,
# LOG_LEVEL, ...) live in the root .env, which `bun run dev` / `bun run start` load first; this file
# wins over it, and real environment variables win over both.
# `bun run setup:env` copies this file to .env when missing.

SERVICE_NAME=ai-service

# HTTP: /health/live, /health/ready and /metrics only (no public API; the gateway serves the chat
# API and calls this service over gRPC).
PORT=3004
METRICS_PORT=9468

# gRPC server bind address (ai.v1.AiService). The gateway dials AI_GRPC_URL (default localhost:50054).
GRPC_URL=0.0.0.0:50054

# Apply the platform set and ai's Drizzle history (schema ai) at boot, under a Postgres advisory lock
# (replicas booting together apply them once). Set false when a separate `node dist/migrate.js` job
# owns migrations. Both connect over DATABASE_MIGRATION_URL only (root .env), never DATABASE_URL.
# Roles (root .env): DATABASE_URL = app_runtime and DATABASE_SYSTEM_URL = app_system, both through
# PgBouncer (DATABASE_POOLER=pgbouncer); DATABASE_MIGRATION_URL = app_owner, direct to Postgres.
DATABASE_RUN_MIGRATIONS=true

# The model's read-only tools call the owners as the caller: identity-service (get_my_profile),
# notifications-service (list_my_notifications) and billing-service (list_my_payments).
IDENTITY_GRPC_URL=localhost:50051
NOTIFICATIONS_GRPC_URL=localhost:50052
BILLING_GRPC_URL=localhost:50053

# AI is off by default (AI_ENABLED=false: every turn answers 503 AI_DISABLED and nothing calls
# OpenRouter). Usually set in the root .env with OPENROUTER_API_KEY; a value here wins over it.
# AI_ENABLED=false
