# apps/gateway — app-specific overrides ONLY. Everything else (Redis, Kafka brokers, JWT secrets,
# CORS, throttling, storage, GraphQL…) comes from the root .env and the defaults in libs/config.
# `bun run setup:env` copies this file to apps/gateway/.env (never overwrites).
# Real environment variables win over both files (Node --env-file semantics).

SERVICE_NAME=gateway
PORT=3000

# Consumer group of the push consumer (notification-created → Socket.IO / GraphQL subscription).
# Every gateway replica must share it; it must differ from notifications-service's group.
KAFKA_GROUP_ID=gateway-push

# Upstream gRPC services (host:port) and the per-call deadline (ms).
IDENTITY_GRPC_URL=localhost:50051
NOTIFICATIONS_GRPC_URL=localhost:50052
BILLING_GRPC_URL=localhost:50053
GRPC_DEADLINE_MS=5000
