{
  "name": "@app/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API gateway (microservices topology): REST + GraphQL + Socket.IO edge whose ports call identity-, notifications- and billing-service over gRPC; Kafka push consumer; JWT verification, RBAC, throttling and docs at the edge.",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=../../.env --env-file-if-exists=.env --enable-source-maps --conditions=@app/source --import @swc-node/register/esm-register --import ./src/instrument.ts src/main.ts",
    "start:dev": "bun run dev",
    "g": "sh -c 'nest g \"$@\" && eslint --fix src' nest-g",
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import ./dist/instrument.js dist/main.js",
    "start:prod": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project gateway",
    "test:e2e": "vitest run --config ../../vitest.config.ts --project gateway:e2e",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@app/auth": "workspace:*",
    "@app/billing": "workspace:*",
    "@app/bootstrap": "workspace:*",
    "@app/common": "workspace:*",
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/files": "workspace:*",
    "@app/graphql": "workspace:*",
    "@app/identity": "workspace:*",
    "@app/notifications": "workspace:*",
    "@app/observability": "workspace:*",
    "@app/redis": "workspace:*",
    "@app/storage": "workspace:*",
    "@app/transport": "workspace:*",
    "@as-integrations/fastify": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@nestjs/cache-manager": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "graphql-ws": "catalog:",
    "ioredis": "catalog:",
    "kafkajs": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "cache-manager": "catalog:",
    "graphql-subscriptions": "catalog:"
  }
}
