# identity-service — app-specific overrides only. Shared settings (DATABASE_URL, REDIS_URL,
# KAFKA_BROKERS, JWT_* secrets, LOG_LEVEL, ...) live in the root .env, which `bun run dev` /
# `bun run start` load first; this file wins over it, and real environment variables win over both.
# `bun run setup:env` copies this file to .env when missing.

SERVICE_NAME=identity-service

# HTTP: /health/live, /health/ready and /metrics only (no public API).
PORT=3001

# gRPC server bind address (identity.v1.AuthService + UsersService). The gateway dials
# IDENTITY_GRPC_URL (default localhost:50051).
GRPC_URL=0.0.0.0:50051

# identity-service only PRODUCES identity.user-registered.v1 (no consumer), so no group joins
# today. Explicit anyway: a consumer added later must never inherit another service's group.
KAFKA_GROUP_ID=identity-service

# Apply the shared Drizzle migrations (libs/database/src/migrations) at boot, under a Postgres
# advisory lock (replicas booting together apply them once). Set false when a separate
# `bun run db:migrate` job owns migrations.
DATABASE_RUN_MIGRATIONS=true
