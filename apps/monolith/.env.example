# apps/monolith — app-specific overrides ONLY. Everything else (Postgres, Cassandra, Redis, Kafka,
# SMTP, JWT secrets, Stripe, storage…) comes from the root .env and the defaults in libs/config.
# `bun run setup:env` copies this file to apps/monolith/.env (never overwrites).
# Real environment variables win over both files (Node --env-file semantics).

SERVICE_NAME=monolith
PORT=3000
METRICS_PORT=9464

# Consumer group of the in-process Kafka consumers; every monolith replica must share it.
KAFKA_GROUP_ID=monolith

# Local development: apply the Postgres (drizzle) and Cassandra (CQL) migrations at boot. Both are
# safe with several replicas (advisory lock / LWT claim); in production prefer running this app's
# `dist/migrate.js` (its `db:migrate` script) as a release job and DATABASE_RUN_MIGRATIONS=false.
# Postgres migrations connect over DATABASE_MIGRATION_URL only (root .env), never DATABASE_URL.
# Roles (root .env): DATABASE_URL = app_runtime and DATABASE_SYSTEM_URL = app_system, both through
# PgBouncer (DATABASE_POOLER=pgbouncer); DATABASE_MIGRATION_URL = app_owner, direct to Postgres.
DATABASE_RUN_MIGRATIONS=true
CASSANDRA_RUN_MIGRATIONS=true

# Transactional outbox relays (`identity.outbox` and `billing.outbox`): integration events are
# written to the outbox in the transaction that changes state, and the relay publishes them to
# Kafka (at least once). Every replica runs one relay per outbox; only the holder of the Redis
# lock `outbox-relay:<schema>` publishes. It needs DATABASE_SYSTEM_URL (root .env) and does not start without it. Tuning
# (OUTBOX_POLL_INTERVAL_MS, OUTBOX_BATCH_SIZE, OUTBOX_LOCK_TTL_MS, ...) lives in the root .env.
OUTBOX_RELAY_ENABLED=true

# The immudb ledger (billing's money postings). Off by default: the monolith boots without immudb.
# With LEDGER_ENABLED=true it loads immudb (IMMUDB_* in the root .env), consumes
# billing.ledger-posting.v1 in the group above, reports immudb in /health/ready, and `db:migrate`
# also provisions immudb and applies the ledger migrations (needs IMMUDB_ADMIN_PASSWORD; or
# IMMUDB_RUN_MIGRATIONS=true at boot). Usually set in the root .env: a value here wins over it.
# LEDGER_ENABLED=false
