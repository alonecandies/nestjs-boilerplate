# apps/monolith — app-specific overrides ONLY. Everything else (Postgres, Cassandra, Redis, Kafka,
# SMTP, JWT secrets, Stripe, storage…) comes from the root .env and the defaults in libs/config.
# `bun run setup:env` copies this file to apps/monolith/.env (never overwrites).
# Real environment variables win over both files (Node --env-file semantics).

SERVICE_NAME=monolith
PORT=3000

# Consumer group of the in-process Kafka consumers; every monolith replica must share it.
KAFKA_GROUP_ID=monolith

# Local development: apply the Postgres (drizzle) and Cassandra (CQL) migrations at boot. Both are
# safe with several replicas (advisory lock / LWT claim); in production prefer running
# `bun run db:migrate` as a release job and DATABASE_RUN_MIGRATIONS=false.
DATABASE_RUN_MIGRATIONS=true
CASSANDRA_RUN_MIGRATIONS=true
