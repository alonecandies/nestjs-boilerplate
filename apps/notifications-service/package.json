{
  "name": "@app/notifications-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "notifications-service: gRPC notifications.v1 NotificationsService (Cassandra inbox) + Kafka consumers (welcome, payment receipt) + BullMQ mail worker + daily digest cron; HTTP only for /health and /metrics.",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=../../.env --env-file-if-exists=.env --enable-source-maps --conditions=@app/source --import @swc-node/register/esm-register src/main.ts",
    "start:dev": "bun run dev",
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import ./dist/instrument.js dist/main.js",
    "start:prod": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project notifications-service",
    "test:e2e": "vitest run --config ../../vitest.config.ts --project notifications-service:e2e",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@app/auth": "workspace:*",
    "@app/bootstrap": "workspace:*",
    "@app/cassandra": "workspace:*",
    "@app/common": "workspace:*",
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/mailer": "workspace:*",
    "@app/notifications": "workspace:*",
    "@app/observability": "workspace:*",
    "@app/redis": "workspace:*",
    "@app/transport": "workspace:*",
    "@fastify/static": "catalog:",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@nestjs-modules/mailer": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/websockets": "catalog:",
    "bullmq": "catalog:",
    "cassandra-driver": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "kafkajs": "catalog:",
    "nestjs-pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@app/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:"
  }
}
