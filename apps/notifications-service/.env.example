# notifications-service — app-specific overrides only. Shared settings (CASSANDRA_*, REDIS_URL,
# KAFKA_BROKERS, SMTP_*, MAIL_FROM, LOG_LEVEL, ...) live in the root .env, which `bun run dev` /
# `bun run start` load first; this file wins over it, and real environment variables win over both.
# `bun run setup:env` copies this file to .env when missing.

SERVICE_NAME=notifications-service

# HTTP: /health/live, /health/ready and /metrics only (no public API).
PORT=3002

# gRPC server bind address (notifications.v1.NotificationsService). The gateway dials
# NOTIFICATIONS_GRPC_URL (default localhost:50052).
GRPC_URL=0.0.0.0:50052

# Consumer group of identity.user-registered.v1 + billing.payment-succeeded.v1. main.ts pins the
# group to 'notifications-service' (see src/notifications-service.constants.ts); keep this equal so
# every Kafka setting of the service names the same group.
KAFKA_GROUP_ID=notifications-service

# Keyspace + CQL migrations at boot (default true; set false when a job owns schema changes).
CASSANDRA_RUN_MIGRATIONS=true
