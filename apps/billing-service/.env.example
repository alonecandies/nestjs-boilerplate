# billing-service — app-specific overrides only. Shared settings (DATABASE_URL, REDIS_URL,
# KAFKA_BROKERS, STRIPE_* keys, LOG_LEVEL, ...) live in the root .env, which `bun run dev` /
# `bun run start` load first; this file wins over it, and real environment variables win over both.
# `bun run setup:env` copies this file to .env when missing.

SERVICE_NAME=billing-service

# HTTP: /health/live, /health/ready and /metrics only (no public API; the gateway receives the
# Stripe webhook and forwards the raw bytes + signature over gRPC).
PORT=3003
METRICS_PORT=9467

# gRPC server bind address (billing.v1.BillingService). The gateway dials BILLING_GRPC_URL
# (default localhost:50053).
GRPC_URL=0.0.0.0:50053

# Kafka client group of this service. Its only consumer (billing.ledger-posting.v1, with
# LEDGER_ENABLED=true) always joins the fixed group `billing-service`; with the ledger off the
# service only produces (through billing.outbox) and joins no group.
KAFKA_GROUP_ID=billing-service

# Apply the platform set and billing's Drizzle history (schema billing) at boot, under a Postgres
# advisory lock (replicas booting together apply them once). Set false when a separate
# `node dist/migrate.js` job owns migrations. Both connect over DATABASE_MIGRATION_URL only (root
# .env), never DATABASE_URL.
# Roles (root .env): DATABASE_URL = app_runtime and DATABASE_SYSTEM_URL = app_system, both through
# PgBouncer (DATABASE_POOLER=pgbouncer); DATABASE_MIGRATION_URL = app_owner, direct to Postgres.
DATABASE_RUN_MIGRATIONS=true

# Transactional outbox relay (`billing.outbox`): integration events are written to the outbox in the
# transaction that changes state, and the relay publishes them to Kafka (at least once). Every
# replica runs one relay per outbox; only the holder of the Redis lock `outbox-relay:billing`
# publishes. It needs DATABASE_SYSTEM_URL (root .env) and does not start without it. Tuning
# (OUTBOX_POLL_INTERVAL_MS, OUTBOX_BATCH_SIZE, OUTBOX_LOCK_TTL_MS, ...) lives in the root .env.
OUTBOX_RELAY_ENABLED=true

# Stripe: test-mode placeholders by default (checkout calls fail until real keys are set; webhook
# verification needs the endpoint's signing secret). Real keys belong in a secret store, not here.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# The immudb ledger (billing's money postings). Off by default: the service boots without immudb
# and connects no Kafka consumer. With LEDGER_ENABLED=true it loads immudb (IMMUDB_* in the root
# .env), connects its first Kafka consumer (billing.ledger-posting.v1, group billing-service),
# reports immudb in /health/ready, and `db:migrate` also provisions immudb and applies the ledger
# migrations (needs IMMUDB_ADMIN_PASSWORD; or IMMUDB_RUN_MIGRATIONS=true at boot). Usually set in
# the root .env: a value here wins over it.
# LEDGER_ENABLED=false
