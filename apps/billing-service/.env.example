# billing-service — app-specific overrides only. Shared settings (DATABASE_URL, REDIS_URL,
# KAFKA_BROKERS, STRIPE_* keys, LOG_LEVEL, ...) live in the root .env, which `bun run dev` /
# `bun run start` load first; this file wins over it, and real environment variables win over both.
# `bun run setup:env` copies this file to .env when missing.

SERVICE_NAME=billing-service

# HTTP: /health/live, /health/ready and /metrics only (no public API; the gateway receives the
# Stripe webhook and forwards the raw bytes + signature over gRPC).
PORT=3003

# gRPC server bind address (billing.v1.BillingService). The gateway dials BILLING_GRPC_URL
# (default localhost:50053).
GRPC_URL=0.0.0.0:50053

# billing-service only PRODUCES billing.payment-succeeded.v1 (no consumer), so no group joins
# today. Explicit anyway: a consumer added later must never inherit another service's group.
KAFKA_GROUP_ID=billing-service

# Apply the shared Drizzle migrations (libs/database/src/migrations) at boot, under a Postgres
# advisory lock (replicas booting together apply them once). Set false when a separate
# `bun run db:migrate` job owns migrations.
DATABASE_RUN_MIGRATIONS=true

# Stripe: test-mode placeholders by default (checkout calls fail until real keys are set; webhook
# verification needs the endpoint's signing secret). Real keys belong in a secret store, not here.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
