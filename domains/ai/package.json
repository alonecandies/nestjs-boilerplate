{
  "name": "@domain/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI bounded context: per-tenant conversations, messages and a usage log (Drizzle, Citus, RLS) and the chat API (REST, GraphQL, SSE and subscription streaming, RBAC, rate limit, idempotency, read-only tools run as the caller) over @platform/ai; served as ai.v1 over gRPC by ai-service (forRemote at the gateway).",
  "exports": {
    ".": {
      "@repo/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "@repo/source": "./src/api/index.ts",
      "types": "./src/api/index.ts",
      "default": "./dist/api/index.js"
    },
    "./testing": {
      "@repo/source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project ai",
    "clean": "rimraf dist coverage",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio --port 4985"
  },
  "dependencies": {
    "@domain/billing-contracts": "workspace:*",
    "@domain/ai-contracts": "workspace:*",
    "@domain/identity-contracts": "workspace:*",
    "@domain/notifications-contracts": "workspace:*",
    "@platform/ai": "workspace:*",
    "@platform/auth": "workspace:*",
    "@platform/common": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/database": "workspace:*",
    "@platform/graphql": "workspace:*",
    "@platform/redis": "workspace:*",
    "@platform/transport": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/swagger": "catalog:",
    "ai": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "lodash-es": "catalog:",
    "zod": "catalog:",
    "nestjs-cls": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@platform/testing": "workspace:*",
    "@nestjs/core": "catalog:",
    "@types/lodash-es": "catalog:",
    "drizzle-kit": "catalog:",
    "postgres": "catalog:"
  }
}
