{
  "name": "@domain/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Identity bounded context: users, registration, login (argon2 + JWT access/refresh), refresh-token rotation with reuse detection, RBAC role management \u2014 REST, GraphQL and gRPC presentation over CQRS.",
  "exports": {
    ".": {
      "@repo/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "@repo/source": "./src/api/index.ts",
      "types": "./src/api/index.ts",
      "default": "./dist/api/index.js"
    },
    "./testing": {
      "@repo/source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project identity",
    "clean": "rimraf dist coverage",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "staff:grant": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --conditions=@repo/source --import @swc-node/register/esm-register src/cli/staff-grant.main.ts"
  },
  "dependencies": {
    "@platform/auth": "workspace:*",
    "@platform/common": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@domain/identity-contracts": "workspace:*",
    "@platform/database": "workspace:*",
    "@platform/graphql": "workspace:*",
    "@platform/redis": "workspace:*",
    "@platform/transport": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@node-rs/argon2": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "dataloader": "catalog:",
    "drizzle-orm": "catalog:",
    "lodash-es": "catalog:",
    "nestjs-cls": "catalog:",
    "passport-local": "catalog:",
    "postgres": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/passport-local": "catalog:",
    "drizzle-kit": "catalog:"
  }
}
