{
  "name": "nestjs-boilerplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade NestJS 12 boilerplate: modular monolith + microservices (Fastify, GraphQL, gRPC, Kafka, WebSocket, CQRS, Postgres/Drizzle, Cassandra, Redis).",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "catalog": {
    "@apollo/server": "5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/lib-storage": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@bufbuild/buf": "1.73.0",
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@google-cloud/storage": "8.2.0",
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "@grpc/reflection": "1.0.4",
    "@keyv/redis": "5.1.6",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "2.0.1",
    "@nestjs-modules/mailer": "2.3.7",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/cli": "12.0.8",
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/microservices": "12.1.1",
    "@nestjs/observe": "0.3.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-fastify": "12.1.1",
    "@nestjs/platform-socket.io": "12.1.1",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/testing": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.1",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scalar/nestjs-api-reference": "1.2.23",
    "@sesamecare-oss/redlock": "1.4.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/lodash-es": "4.17.12",
    "@types/opossum": "8.1.9",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.1",
    "@willsoto/nestjs-prometheus": "6.1.1",
    "bullmq": "6.3.9",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "cassandra-driver": "4.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dataloader": "2.2.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "0.8.3",
    "fastify": "5.12.5",
    "graphql": "17.0.2",
    "graphql-query-complexity": "2.0.0",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-scalars": "2.0.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.3.0",
    "grpc-health-check": "2.1.0",
    "handlebars": "4.7.9",
    "import-in-the-middle": "3.5.1",
    "ioredis": "6.0.0",
    "kafkajs": "2.2.4",
    "keyv": "5.6.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "nestjs-cls": "7.0.1",
    "nestjs-otel": "8.1.1",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.12",
    "opossum": "10.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "protobufjs": "7.6.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "stripe": "22.6.2",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "ts-proto": "2.12.4",
    "uuid": "14.0.2",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  },
  "scripts": {
    "prepare": "husky",
    "setup": "bun install && bun run setup:env",
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "bun run dev:monolith",
    "dev:monolith": "bun run setup:env && bun run --filter @app/monolith dev",
    "dev:gateway": "bun run setup:env && bun run --filter @app/gateway dev",
    "dev:identity": "bun run setup:env && bun run --filter @app/identity-service dev",
    "dev:notifications": "bun run setup:env && bun run --filter @app/notifications-service dev",
    "dev:billing": "bun run setup:env && bun run --filter @app/billing-service dev",
    "dev:microservices": "bun run setup:env && concurrently --kill-others-on-fail -n gateway,identity,notify,billing -c blue,green,magenta,yellow \"bun run --filter @app/gateway dev\" \"bun run --filter @app/identity-service dev\" \"bun run --filter @app/notifications-service dev\" \"bun run --filter @app/billing-service dev\"",
    "build": "lerna run build",
    "build:affected": "lerna run build --since origin/master",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project '*:e2e'",
    "test:cov": "vitest run --coverage",
    "test:int": "INTEGRATION=1 vitest run --project '*:int'",
    "lint": "biome check . && eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "biome check --write . && eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "biome format --write . && prettier --write --log-level=warn .",
    "check": "biome ci . && eslint . --max-warnings=0 && prettier --check . && tsc -p tsconfig.json",
    "commit": "cz",
    "release": "lerna version --conventional-commits --yes --no-push",
    "clean": "lerna run clean && rimraf node_modules/.cache .nx",
    "graph": "nx graph",
    "proto:gen": "bun run --filter @app/contracts proto:gen",
    "db:generate": "bun run --filter @app/database db:generate",
    "db:migrate": "bun run --filter @app/database db:migrate:dev",
    "db:studio": "bun run --filter @app/database db:studio",
    "docker:infra": "docker compose up -d --wait",
    "docker:monolith": "docker compose --profile monolith up -d --build --wait",
    "docker:microservices": "docker compose --profile microservices up -d --build --wait",
    "docker:observability": "docker compose --profile observability up -d --wait",
    "docker:down": "docker compose --profile '*' down",
    "loadtest": "docker compose --profile loadtest run --rm k6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/config-workspace-scopes": "21.2.0",
    "@commitlint/cz-commitlint": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/lodash-es": "catalog:",
    "@types/node": "24.19.0",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "5.0.2",
    "commitizen": "4.3.2",
    "concurrently": "10.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.11.0",
    "eslint-config-biome": "2.1.3",
    "husky": "9.1.7",
    "inquirer": "12.11.1",
    "jiti": "2.7.0",
    "lerna": "10.0.1",
    "lint-staged": "17.6.0",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "reflect-metadata": "catalog:",
    "rimraf": "6.1.3",
    "supertest": "catalog:",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.1",
    "vitest": "catalog:"
  },
  "overrides": {
    "socket.io": "4.8.4",
    "ioredis": "6.0.0",
    "fastify": "5.12.5",
    "protobufjs": "7.6.6"
  },
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "protobufjs",
    "@apollo/protobufjs",
    "@bufbuild/buf",
    "msgpackr-extract",
    "nx"
  ],
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
