# ─────────────────────────────────────────────────────────────────────────────────────────────
# Root environment for apps run ON THE HOST (`bun run dev`, `bun run dev:microservices`).
#   bun run setup:env      # copies this file to .env (and apps/*/.env.example to apps/*/.env)
#
# Every variable read by @app/config is listed, grouped by config namespace. The values are the
# built-in defaults, which already target the local docker-compose infra (`docker compose up -d`):
# the apps also boot with NO .env at all. Commented lines = tuning knobs; uncomment to change.
# Load order: shell env > apps/<app>/.env > this file (Node --env-file-if-exists, last file wins).
# Per-app values (SERVICE_NAME, PORT, GRPC_URL, KAFKA_GROUP_ID) belong in apps/<app>/.env.
#
# Rules: one KEY=value per line, no inline comments, quote values with spaces. Blank = unset.
# docker compose ALSO reads this file, but only for ${VAR} interpolation of the compose-only knobs
# at the bottom: containers get their app env from docker-compose.yml, never from these values.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── app: HTTP server, CORS, cluster, shutdown, maintenance, docs (every app) ────────────────
# development | test | production (production rejects the dev JWT secrets and disables docs/sandbox)
NODE_ENV=development
# Logical service name (logs, metrics, OTel service.name, Kafka client/group id, DB application_name)
# SERVICE_NAME=app
# HOST=0.0.0.0
# gateway|monolith 3000, identity-service 3001, notifications-service 3002, billing-service 3003
# PORT=3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Whose X-Forwarded-* to honour: false (default: nobody, req.ip = socket address), or a CSV of the
# load balancer / ingress IPs/CIDRs (e.g. 10.0.0.0/8; presets loopback, linklocal, uniquelocal).
# true trusts EVERY hop (any client can spoof its IP and dodge the per-IP throttle): rejected in production.
# TRUST_PROXY=false
# BODY_LIMIT_BYTES=1048576
# Must exceed the load balancer idle timeout (60 s typical) or the LB reuses closed sockets (502s)
# HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
# Also bounds streamed uploads (raise it for large multipart uploads)
# HTTP_REQUEST_TIMEOUT_MS=30000
# node:cluster workers: 1 = no cluster, 0 = one per core (os.availableParallelism())
# CLUSTER_WORKERS=1
# Hard deadline for the graceful shutdown (keep below the orchestrator grace period)
# SHUTDOWN_TIMEOUT_MS=10000
# 503 problem+json + Retry-After on every route except /health* and /metrics
# MAINTENANCE_MODE=false
# Swagger/Scalar (/docs, /openapi.json|yaml); default: on unless NODE_ENV=production
# DOCS_ENABLED=

# ── observability: logs, metrics, tracing, @nestjs/observe (every app) ──────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (pino-pretty, ~5x slower); default: on when NODE_ENV=development
# LOG_PRETTY=
# GET /metrics (prom-client)
# METRICS_ENABLED=true
# When set (min 16 chars), /metrics answers 404 unless the scrape sends Authorization: Bearer <token>
# METRICS_BEARER_TOKEN=
# Tracing is ON only when an OTLP endpoint is set (explicit OTEL_SDK_DISABLED wins).
# Jaeger from `docker compose --profile observability up -d` listens on localhost:4318 (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_SDK_DISABLED=
# Standard OTel SDK variables are honoured too (read by the SDK itself, not by @app/config):
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# @nestjs/observe (hosted devtools/APM): enabled only when BOTH key and secret are set
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=

# ── database: PostgreSQL 18 via postgres.js + Drizzle (monolith, identity-service, billing-service)
DATABASE_URL=postgres://app:app@localhost:5432/app
# DATABASE_POOL_MAX=20
# Seconds (postgres.js); 0 = disabled
# DATABASE_IDLE_TIMEOUT_SEC=30
# DATABASE_MAX_LIFETIME_SEC=1800
# DATABASE_CONNECT_TIMEOUT_SEC=10
# Milliseconds (Postgres GUC); 0 = disabled
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Server-side prepared statements; set false behind PgBouncer (transaction mode) / RDS Proxy
# DATABASE_PREPARE=true
# DATABASE_LOG_QUERIES=false
# Run Drizzle migrations at boot (advisory-locked); otherwise `bun run db:migrate`
# DATABASE_RUN_MIGRATIONS=false

# ── cassandra: notifications inbox (monolith, notifications-service) ────────────────────────
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
# Must equal the node's data center (compose: datacenter1) or the driver ignores every node
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=app
# Set both or neither
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
# Replication of the keyspace created at boot (SimpleStrategy)
# CASSANDRA_REPLICATION_FACTOR=1
# localOne | localQuorum | quorum | one
# CASSANDRA_CONSISTENCY=localOne
# CASSANDRA_CORE_CONNECTIONS=2
# CASSANDRA_REQUEST_TIMEOUT_MS=12000
# Versioned CQL migrations at boot (LWT-locked)
# CASSANDRA_RUN_MIGRATIONS=true

# ── redis: cache, locks, throttling, BullMQ, socket.io adapter, GraphQL pub/sub (every app) ──
# redis://[:password@]host:port[/db] or rediss:// for TLS
REDIS_URL=redis://localhost:6379
# Applied by the key builder (not ioredis keyPrefix, which breaks BullMQ/redlock)
# REDIS_KEY_PREFIX=app
# REDIS_MAX_RETRIES_PER_REQUEST=3
# REDIS_CONNECT_TIMEOUT_MS=10000

# ── kafka: integration events (every app except the gateway's producer side) ────────────────
# Host apps use the EXTERNAL listener localhost:9094 (containers use kafka:9092)
KAFKA_BROKERS=localhost:9094
# Both default to SERVICE_NAME (the apps pass their consumer group explicitly)
# KAFKA_CLIENT_ID=
# KAFKA_GROUP_ID=
# Partitions consumed in parallel per instance
# KAFKA_CONSUMER_CONCURRENCY=3
# KAFKA_SSL=false
# plain | scram-sha-256 | scram-sha-512 (username + password then required)
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_CONNECTION_TIMEOUT_MS=3000
# KAFKA_REQUEST_TIMEOUT_MS=30000

# ── grpc: server bind + client targets (gateway = clients; services = servers) ──────────────
# Server bind of THIS service (per app: identity 50051, notifications 50052, billing 50053)
# GRPC_URL=0.0.0.0:50051
IDENTITY_GRPC_URL=localhost:50051
NOTIFICATIONS_GRPC_URL=localhost:50052
BILLING_GRPC_URL=localhost:50053
# Per-call deadline (every client call has one)
# GRPC_DEADLINE_MS=5000
# GRPC_MAX_MESSAGE_BYTES=4194304
# Without TLS, internal gRPC is plaintext and UNAUTHENTICATED (callers are trusted). CERT + KEY
# (PEM) enable TLS for the server and as this process's client certificate; CA = what signed the
# peers' certificates. Client certificates are required (mTLS) unless REQUIRE_CLIENT_CERT=false.
# GRPC_TLS_CA_PATH=
# GRPC_TLS_CERT_PATH=
# GRPC_TLS_KEY_PATH=
# GRPC_TLS_REQUIRE_CLIENT_CERT=true
# NODE_ENV=production refuses plaintext gRPC unless this opt-out is set (mesh/NetworkPolicy)
# GRPC_ALLOW_INSECURE=false
# Server reflection (grpcurl/Postman); default: on unless NODE_ENV=production
# GRPC_REFLECTION=

# ── auth: JWT + Argon2id (gateway, monolith, identity-service) ──────────────────────────────
# >= 32 chars. The defaults below are DEV ONLY and rejected when NODE_ENV=production;
# generate real ones with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
# JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
# JWT_ACCESS_TTL_SEC=900
# JWT_REFRESH_TTL_SEC=604800
# JWT_ISSUER=nestjs-boilerplate
# JWT_AUDIENCE=nestjs-boilerplate
# Argon2id cost (OWASP baseline m=19 MiB, t=2, p=1); hashing runs on the libuv pool (UV_THREADPOOL_SIZE)
# ARGON2_MEMORY_COST=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# Redis denylist of logged-out access tokens (jti)
# AUTH_DENYLIST_ENABLED=true

# ── throttle: rate limits per user (authenticated) or client IP (gateway, monolith) ─────────
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# Stricter window for login/register (brute-force protection)
# THROTTLE_AUTH_TTL_MS=60000
# THROTTLE_AUTH_LIMIT=10

# ── cache: L1 in-process LRU + L2 Redis (gateway, monolith) ─────────────────────────────────
# CACHE_TTL_MS=30000
# Must not exceed CACHE_TTL_MS
# CACHE_L1_TTL_MS=5000
# CACHE_L1_MAX_ITEMS=5000

# ── graphql: Apollo on Fastify (gateway, monolith) ──────────────────────────────────────────
# GRAPHQL_PATH=/graphql
# Apollo Sandbox landing page / introspection; default: on unless NODE_ENV=production
# GRAPHQL_SANDBOX=
# GRAPHQL_INTROSPECTION=
# GRAPHQL_MAX_COMPLEXITY=250
# Also write the code-first schema to this file (e.g. generated/schema.gql)
# GRAPHQL_SCHEMA_FILE=

# ── mail: SMTP + BullMQ mail queue (monolith, notifications-service) ────────────────────────
# Mailpit from docker compose (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (465); false = STARTTLS when offered
# SMTP_SECURE=false
# Set both or neither
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="NestJS Boilerplate <no-reply@example.com>"
# SMTP_POOL=true
# SMTP_MAX_CONNECTIONS=5
# MAIL_QUEUE_CONCURRENCY=5

# ── storage: uploads to S3 or GCS (gateway, monolith) ───────────────────────────────────────
# s3 (RustFS locally) | gcs (fake-gcs-server locally)
STORAGE_DRIVER=s3
# 25 MiB
# STORAGE_MAX_UPLOAD_BYTES=26214400
# Streamed uploads (POST /v1/files) in flight per process; more get 503 + Retry-After.
# Each one holds up to ~15 MiB of off-heap Buffers (S3 multipart: 3 × 5 MiB parts).
# STORAGE_MAX_CONCURRENT_UPLOADS=4
# Presigned URL lifetime (max 7 days)
# STORAGE_SIGNED_URL_TTL_SEC=900
S3_ENDPOINT=http://localhost:9000
# Host baked into presigned URLs (default = S3_ENDPOINT); must be reachable by the client
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# Required by RustFS/MinIO-style endpoints (no wildcard DNS)
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=uploads
GCS_PROJECT_ID=local-project
GCS_BUCKET=uploads
# A non-googleapis.com host = emulator mode; real GCS: https://storage.googleapis.com
GCS_API_ENDPOINT=http://localhost:4443
# Service-account key file; unset = Application Default Credentials
# GCS_KEY_FILE=

# ── stripe: Checkout + webhooks (monolith, billing-service) ─────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys (sk_/rk_ prefix enforced);
# webhook secret from `stripe listen --forward-to localhost:3000/v1/billing/webhooks/stripe`.
# docker compose passes these two through to the containers.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
# STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
# STRIPE_MAX_NETWORK_RETRIES=2
# STRIPE_TIMEOUT_MS=20000

# ── Node.js runtime (read by Node itself) ───────────────────────────────────────────────────
# libuv pool (Argon2id, zlib, fs, dns.lookup); default 4. Keep it <= the CPUs available to the
# process: more busy threads than CPUs starve the event loop (measured, see docs/DOCKER.md).
# UV_THREADPOOL_SIZE=4
# NODE_OPTIONS=--max-old-space-size=512

# ═════════════════════════════════════════════════════════════════════════════════════════════
# docker compose ONLY (interpolation in docker-compose.yml; ignored by the apps). See docs/DOCKER.md.
# ═════════════════════════════════════════════════════════════════════════════════════════════
# Profiles to start without --profile flags (monolith | microservices, observability, logs, tools, loadtest)
# COMPOSE_PROFILES=
# App image build target: runtime (distroless) | runtime-alpine (shell) | dev (TS sources, no build)
# APP_TARGET=runtime
# TAG=local
# App container settings
# DOCKER_NODE_ENV=production
# DOCKER_LOG_LEVEL=info
# false = send traces to Jaeger (also start the observability profile)
# DOCKER_OTEL_SDK_DISABLED=true
# DOCKER_OTEL_SAMPLER_RATIO=1.0
# DOCKER_DOCS_ENABLED=true
# DOCKER_STORAGE_DRIVER=s3
# Non-default local secrets (NODE_ENV=production rejects the dev defaults); >= 32 chars
# DOCKER_JWT_ACCESS_SECRET=compose-local-access-secret-not-for-production-0001
# DOCKER_JWT_REFRESH_SECRET=compose-local-refresh-secret-not-for-production-0002
# Infra credentials (change DATABASE_URL / S3_* above to match for host apps)
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=app
# RUSTFS_ACCESS_KEY=rustfsadmin
# RUSTFS_SECRET_KEY=rustfsadmin
# Browser origins allowed by RustFS's S3 listener (presigned uploads from a frontend); comma-separated
# DOCKER_S3_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CASSANDRA_DC=datacenter1
# CASSANDRA_HEAP=512M
# KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# Host ports (all bound to 127.0.0.1)
# API_HOST_PORT=3000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# CASSANDRA_HOST_PORT=9042
# KAFKA_HOST_PORT=9094
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# S3_HOST_PORT=9000
# S3_CONSOLE_HOST_PORT=9001
# GCS_HOST_PORT=4443
# IDENTITY_GRPC_HOST_PORT=50051
# NOTIFICATIONS_GRPC_HOST_PORT=50052
# BILLING_GRPC_HOST_PORT=50053
# KAFKA_UI_HOST_PORT=8080
# JAEGER_UI_HOST_PORT=16686
# OTLP_GRPC_HOST_PORT=4317
# OTLP_HTTP_HOST_PORT=4318
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3300
# LOKI_HOST_PORT=3100
# ALLOY_HOST_PORT=12345
# K6_DASHBOARD_HOST_PORT=5665
# k6 (docker compose --profile loadtest run --rm k6)
# K6_BASE_URL=http://api:3000
# K6_RATE=5
# K6_READ_RATE=0
# K6_DURATION=1m
# K6_P95_MS=250
# K6_MAX_ERROR_RATE=0.01
# uid:gid the k6 container runs as, so it can write docker/k6/reports on Linux hosts (bash's UID is
# not exported to compose): K6_UID=$(id -u) K6_GID=$(id -g) bun run loadtest
# K6_UID=1000
# K6_GID=1000
# Empty = no Prometheus remote write (when the observability profile is not running)
# K6_OUT=experimental-prometheus-rw
