# ─────────────────────────────────────────────────────────────────────────────────────────────
# Root environment for apps run ON THE HOST (`bun run dev`, `bun run dev:microservices`).
#   bun run setup:env      # copies this file to .env (and apps/*/.env.example to apps/*/.env)
#
# Every variable read by @platform/config is listed, grouped by config namespace. The values are the
# built-in defaults, which already target the local docker-compose infra (`docker compose up -d`):
# the apps also boot with NO .env at all. Commented lines = tuning knobs; uncomment to change.
# Load order: shell env > apps/<app>/.env > this file (Node --env-file-if-exists, last file wins).
# Per-app values (SERVICE_NAME, PORT, GRPC_URL, KAFKA_GROUP_ID) belong in apps/<app>/.env.
#
# Rules: one KEY=value per line, no inline comments, quote values with spaces. Blank = unset.
# docker compose ALSO reads this file, but only for ${VAR} interpolation of the compose-only knobs
# at the bottom: containers get their app env from docker-compose.yml, never from these values.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── app: HTTP server, CORS, cluster, shutdown, maintenance, docs (every app) ────────────────
# development | test | production (production rejects the dev JWT secrets and disables docs/sandbox)
NODE_ENV=development
# Logical service name (logs, metrics, OTel service.name, Kafka client/group id, DB application_name)
# SERVICE_NAME=app
# HOST=0.0.0.0
# gateway|monolith 3000, identity-service 3001, notifications-service 3002, billing-service 3003
# PORT=3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Whose X-Forwarded-* to honour: false (default: nobody, req.ip = socket address), or a CSV of the
# load balancer / ingress IPs/CIDRs (e.g. 10.0.0.0/8; presets loopback, linklocal, uniquelocal).
# true trusts EVERY hop (any client can spoof its IP and dodge the per-IP throttle): rejected in production.
# TRUST_PROXY=false
# BODY_LIMIT_BYTES=1048576
# Must exceed the load balancer idle timeout (60 s typical) or the LB reuses closed sockets (502s)
# HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
# Also bounds streamed uploads (raise it for large multipart uploads)
# HTTP_REQUEST_TIMEOUT_MS=30000
# Per-handler budget (504 when exceeded; @Timeout(ms) overrides it per route):
# HTTP_HANDLER_TIMEOUT_MS=30000
# node:cluster workers: 1 = no cluster, 0 = one per core (os.availableParallelism())
# CLUSTER_WORKERS=1
# Hard deadline for the graceful shutdown (keep below the orchestrator grace period)
# SHUTDOWN_TIMEOUT_MS=10000
# 503 problem+json + Retry-After on every route except /health* and /metrics
# MAINTENANCE_MODE=false
# Swagger/Scalar (/docs, /openapi.json|yaml); default: on unless NODE_ENV=production
# DOCS_ENABLED=

# ── observability: logs, metrics, tracing, @nestjs/observe (every app) ──────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (pino-pretty, ~5x slower); default: on when NODE_ENV=development
# LOG_PRETTY=
# GET /metrics (prom-client)
# METRICS_ENABLED=true
# When set (min 16 chars), /metrics answers 404 unless the scrape sends Authorization: Bearer <token>
# METRICS_BEARER_TOKEN=
# Separate /metrics listener (never the API port). Host dev defaults (apps/*/.env.example): 9464
# monolith | gateway, 9465 identity-service, 9466 notifications-service, 9467 billing-service.
# Every container uses 9464 (Prometheus scrapes it in-network; it is never published).
# METRICS_PORT=9464
# Tracing is ON only when an OTLP endpoint is set (explicit OTEL_SDK_DISABLED wins).
# Jaeger from `docker compose --profile observability up -d` listens on localhost:4318 (OTLP/HTTP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_SDK_DISABLED=
# Standard OTel SDK variables are honoured too (read by the SDK itself, not by @platform/config):
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# @nestjs/observe (hosted devtools/APM): enabled only when BOTH key and secret are set
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=

# ── database: PostgreSQL 18 via postgres.js + Drizzle (monolith, identity-service, billing-service)
# The three roles of docker/postgres/init/02-roles.sql (dev passwords = role names). Compose (and a
# host app against the compose stack) reaches Postgres two ways: requests and the system pool go
# through PgBouncer (127.0.0.1:${PGBOUNCER_HOST_PORT}, default 6432); migrations go straight to the
# coordinator (127.0.0.1:${POSTGRES_HOST_PORT}, default 5432). The roles exist only on a data
# directory created by this stack version: `docker compose down -v` once after upgrading.
# DATABASE_URL: every request (the app_runtime role, NOBYPASSRLS; through PgBouncer when pooled)
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:6432/app
# The migrator (DATABASE_RUN_MIGRATIONS, db:migrate), drizzle-kit and staff:grant connect here and
# NEVER over DATABASE_URL: the app_owner role, directly to the coordinator (never PgBouncer). No
# fallback: unset means the migrator and the CLIs refuse to run.
DATABASE_MIGRATION_URL=postgres://app_owner:app_owner@127.0.0.1:5432/app
# The system pool (app_system, BYPASSRLS; named system methods only), through PgBouncer.
# Unset = no system pool.
DATABASE_SYSTEM_URL=postgres://app_system:app_system@127.0.0.1:6432/app
# DATABASE_POOL_MAX=20
# System pool size, 1-5
# DATABASE_SYSTEM_POOL_MAX=5
# none | pgbouncer. pgbouncer: statement_timeout and idle_in_transaction_session_timeout are not
# sent as startup parameters (PgBouncer rejects them; the roles carry them, ALTER ROLE ... SET).
# Required while DATABASE_URL points at PgBouncer (the default above); none for a direct connection
DATABASE_POOLER=pgbouncer
# enforce | warn | off; default enforce in production (which accepts nothing else), warn elsewhere
# DATABASE_BOOT_GUARD=
# Seconds (postgres.js); 0 = disabled
# DATABASE_IDLE_TIMEOUT_SEC=30
# DATABASE_MAX_LIFETIME_SEC=1800
# DATABASE_CONNECT_TIMEOUT_SEC=10
# Milliseconds (Postgres GUC); 0 = disabled
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Server-side prepared statements; PgBouncer 1.26 keeps them (max_prepared_statements). Set false
# only for a pooler that does not (RDS Proxy)
# DATABASE_PREPARE=true
# DATABASE_LOG_QUERIES=false
# Run the Drizzle migrations at boot (platform set, then the app's domain sets; advisory-locked);
# otherwise run the app's migrate job (`bun run --filter @app/<app> db:migrate`, or `dist/migrate.js`
# in the image; the root `bun run db:migrate` applies the monolith's sets)
# DATABASE_RUN_MIGRATIONS=false
# Production requires TLS on all three URLs (?sslmode=verify-full, require or verify-ca, or
# sslrootcert=system) unless a sidecar proxy or the network layer encrypts the connection:
# DATABASE_ALLOW_INSECURE=false

# ── cassandra: notifications inbox (monolith, notifications-service) ────────────────────────
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
# Must equal the node's data center (compose: datacenter1) or the driver ignores every node
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=app
# Set both or neither
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
# Client-to-node TLS (required in production): CA bundle, plus a client certificate if needed.
# CASSANDRA_SSL=false
# CASSANDRA_TLS_CA_PATH=
# CASSANDRA_TLS_CERT_PATH=
# CASSANDRA_TLS_KEY_PATH=
# Replication of the keyspace created at boot (SimpleStrategy)
# CASSANDRA_REPLICATION_FACTOR=1
# NetworkTopologyStrategy for the keyspace (required in production), e.g. dc1:3,dc2:3:
# CASSANDRA_REPLICATION_DATACENTERS=
# localOne | localQuorum | quorum | one
# CASSANDRA_CONSISTENCY=localOne
# CASSANDRA_CORE_CONNECTIONS=2
# CASSANDRA_REQUEST_TIMEOUT_MS=12000
# Versioned CQL migrations at boot (LWT-locked)
# CASSANDRA_RUN_MIGRATIONS=true
# Production requires CASSANDRA_SSL unless a mesh encrypts node traffic (or the local compose stack):
# CASSANDRA_ALLOW_INSECURE=false
# LOCAL single node only: allow creating the keyspace with SimpleStrategy in production mode.
# CASSANDRA_ALLOW_SIMPLE_STRATEGY=false

# ── immudb: append-only verifiable SQL store over gRPC (monolith, billing-service from wave 2) ──
IMMUDB_ADDRESS=localhost:3322
IMMUDB_DATABASE=app
# INSERT/SELECT-only application user (provisioned by the migrate step). immudb policy: 8-32 chars,
# an uppercase letter, a digit and a symbol. The default is refused in production.
IMMUDB_USERNAME=app_writer
# IMMUDB_PASSWORD=Compose-local-App1!
# Superuser for provisioning + migrations only (immudb's built-in default is immudb/immudb,
# refused in production). Leave unset in processes that never migrate.
# IMMUDB_ADMIN_USERNAME=immudb
# IMMUDB_ADMIN_PASSWORD=
# IMMUDB_SESSION_POOL_SIZE=4
# IMMUDB_TIMEOUT_MS=5000
# Below the server's 3-minute session inactivity limit
# IMMUDB_KEEPALIVE_INTERVAL_MS=60000
# gRPC over TLS (required in production unless IMMUDB_ALLOW_INSECURE=true)
# IMMUDB_TLS=false
# IMMUDB_ALLOW_INSECURE=false
# base64 of the PEM public key of the server's --signingKey (verifies state signatures)
# IMMUDB_SERVER_SIGNING_PUBLIC_KEY=
# The same key as a file (a PEM or its base64), e.g. a mounted secret; not together with the above.
# The compose stack generates a development key and mounts its public file here. Refused in
# production while it carries the compose-local marker (see docker/immudb/README.md).
# IMMUDB_SERVER_SIGNING_PUBLIC_KEY_FILE=
# Provision the database/user and apply SQL migrations at boot (needs IMMUDB_ADMIN_PASSWORD)
# IMMUDB_RUN_MIGRATIONS=false

# ── redis: cache, locks, throttling, BullMQ, socket.io adapter, GraphQL pub/sub (every app) ──
# redis://[:password@]host:port[/db] or rediss:// for TLS
REDIS_URL=redis://localhost:6379
# Applied by the key builder (not ioredis keyPrefix, which breaks BullMQ/redlock)
# REDIS_KEY_PREFIX=app
# REDIS_MAX_RETRIES_PER_REQUEST=3
# REDIS_CONNECT_TIMEOUT_MS=10000
# Production requires rediss:// with a password or ACL user unless the network layer secures it:
# REDIS_ALLOW_INSECURE=false

# ── kafka: integration events (every app except the gateway's producer side) ────────────────
# Host apps use the EXTERNAL listener localhost:9094 (containers use kafka:9092)
KAFKA_BROKERS=localhost:9094
# Both default to SERVICE_NAME (the apps pass their consumer group explicitly)
# KAFKA_CLIENT_ID=
# KAFKA_GROUP_ID=
# Partitions consumed in parallel per instance
# KAFKA_CONSUMER_CONCURRENCY=3
# KAFKA_SSL=false
# plain | scram-sha-256 | scram-sha-512 (username + password then required)
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_CONNECTION_TIMEOUT_MS=3000
# KAFKA_REQUEST_TIMEOUT_MS=30000
# Production requires KAFKA_SSL=true unless the network layer secures broker traffic:
# KAFKA_ALLOW_INSECURE=false

# ── outbox: transactional outbox relay, one leader per outbox (not loaded by any app yet) ────
# The relay of each outbox this process owns starts only when it also has a system pool.
# OUTBOX_RELAY_ENABLED=true
# Wait after an empty poll (50..60000); a full batch polls again at once
# OUTBOX_POLL_INTERVAL_MS=500
# Rows per poll (1..500)
# OUTBOX_BATCH_SIZE=100
# TTL of the leader lock outbox-relay:<name> (1000..300000), extended while the term runs
# OUTBOX_LOCK_TTL_MS=15000
# Cap of the doubling wait after a failed publish (at least OUTBOX_POLL_INTERVAL_MS)
# OUTBOX_MAX_BACKOFF_MS=30000
# Published rows older than this are purged (1..8760)
# OUTBOX_RETENTION_HOURS=168

# ── grpc: server bind + client targets (gateway = clients; services = servers) ──────────────
# Server bind of THIS service (per app: identity 50051, notifications 50052, billing 50053)
# GRPC_URL=0.0.0.0:50051
# Client targets (gateway), one namespace per domain read by each XApiModule.forRemote():
# identityGrpcClient, notificationsGrpcClient, billingGrpcClient
IDENTITY_GRPC_URL=localhost:50051
NOTIFICATIONS_GRPC_URL=localhost:50052
BILLING_GRPC_URL=localhost:50053
# Per-call deadline (every client call has one)
# GRPC_DEADLINE_MS=5000
# GRPC_MAX_MESSAGE_BYTES=4194304
# Without TLS, internal gRPC is plaintext and UNAUTHENTICATED (callers are trusted). CERT + KEY
# (PEM) enable TLS for the server and as this process's client certificate; CA = what signed the
# peers' certificates. Client certificates are required (mTLS) unless REQUIRE_CLIENT_CERT=false.
# GRPC_TLS_CA_PATH=
# GRPC_TLS_CERT_PATH=
# GRPC_TLS_KEY_PATH=
# GRPC_TLS_REQUIRE_CLIENT_CERT=true
# NODE_ENV=production refuses plaintext gRPC unless this opt-out is set (mesh/NetworkPolicy)
# GRPC_ALLOW_INSECURE=false
# Server reflection (grpcurl/Postman); default: on unless NODE_ENV=production
# GRPC_REFLECTION=

# ── auth: access tokens, verified at every edge (gateway, monolith, identity-service) ────────
# >= 32 chars. The defaults below are DEV ONLY and rejected when NODE_ENV=production;
# generate real ones with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
# JWT_ACCESS_TTL_SEC=900
# JWT_ISSUER=nestjs-boilerplate
# JWT_AUDIENCE=nestjs-boilerplate
# Redis denylist of logged-out access tokens (jti)
# AUTH_DENYLIST_ENABLED=true
# How often each replica closes its WebSockets (Socket.IO, graphql-ws) whose token was revoked
# (100..300000 ms)
# WS_REVOCATION_SWEEP_INTERVAL_MS=30000
# LOCAL compose stack only: accept the publicly known compose fallbacks (JWT, Stripe, RustFS keys)
# in production mode. The JWT and Stripe development defaults are always rejected in production.
# ALLOW_KNOWN_LOCAL_SECRETS=false

# ── identity: refreshToken + password + staffSwitchIn namespaces (monolith, identity-service) ──
# Refresh-token secret: >= 32 chars, DEV ONLY default (rejected when NODE_ENV=production), and it
# must differ from JWT_ACCESS_SECRET there
# JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
# JWT_REFRESH_TTL_SEC=604800
# Staff switch-in access-token lifetime, identity's staffSwitchIn namespace (monolith, identity-service):
# 60..3600 seconds; no refresh token is issued (spec §5.2)
# STAFF_SWITCH_IN_TTL_SEC=900
# Argon2id cost, identity's password namespace (monolith, identity-service): OWASP baseline
# m=19 MiB, t=2, p=1; hashing runs on the libuv pool (UV_THREADPOOL_SIZE)
# ARGON2_MEMORY_COST=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# ── throttle: rate limits per user (authenticated) or client IP (gateway, monolith) ─────────
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=300
# Pre-auth flood cap per client IP across all routes, counted before the token is checked.
# THROTTLE_IP_TTL_MS=60000
# THROTTLE_IP_LIMIT=600
# Aggregate budget per active tenant (all its members together).
# THROTTLE_TENANT_TTL_MS=60000
# THROTTLE_TENANT_LIMIT=3000
# GraphQL: one charge per operation, weighted by its complexity score, per user (else IP).
# THROTTLE_GRAPHQL_TTL_MS=60000
# THROTTLE_GRAPHQL_COST_LIMIT=20000
# WebSockets (Socket.IO and graphql-ws): handshakes per client IP, and concurrent sockets per user.
# THROTTLE_WS_HANDSHAKE_LIMIT=30
# THROTTLE_WS_HANDSHAKE_TTL_MS=60000
# THROTTLE_WS_SOCKETS_PER_USER=10
# Safety TTL of the per-user socket counter (bounds leaks from crashed replicas).
# THROTTLE_WS_SOCKET_TTL_MS=3600000
# Bound for one rate-limit Redis command. On timeout or outage, budgets fail OPEN (metric
# rate_limit_fail_open_total) and credential endpoints fail CLOSED (503).
# THROTTLE_REDIS_TIMEOUT_MS=250

# ── notificationsRateLimit: named WebSocket policies (gateway, monolith) ─────────────────────
# notifications.mark-read: markRead messages per user per window.
# NOTIFICATIONS_MARK_READ_LIMIT=30
# NOTIFICATIONS_MARK_READ_TTL_MS=10000

# ── identityRateLimit: credential endpoints, register + login REST and GraphQL (gateway, monolith) ──
# identity.credentials: attempts per sha256(email)+client IP per window (replaces THROTTLE_AUTH_*).
# IDENTITY_CREDENTIALS_LIMIT=10
# IDENTITY_CREDENTIALS_TTL_MS=60000
# Lockout: after this many failed attempts per account (any IP) within one IDENTITY_LOCKOUT_MS window, the next
# ones are refused (429) for IDENTITY_LOCKOUT_MS. A success before that resets the count.
# IDENTITY_LOCKOUT_THRESHOLD=10
# IDENTITY_LOCKOUT_MS=900000

# ── cache: L1 in-process LRU + L2 Redis (gateway, monolith) ─────────────────────────────────
# CACHE_TTL_MS=30000
# Must not exceed CACHE_TTL_MS
# CACHE_L1_TTL_MS=5000
# CACHE_L1_MAX_ITEMS=5000

# ── graphql: Apollo on Fastify (gateway, monolith) ──────────────────────────────────────────
# GRAPHQL_PATH=/graphql
# Apollo Sandbox landing page / introspection; default: on unless NODE_ENV=production
# GRAPHQL_SANDBOX=
# GRAPHQL_INTROSPECTION=
# GRAPHQL_MAX_COMPLEXITY=250
# Also write the code-first schema to this file (e.g. generated/schema.gql)
# GRAPHQL_SCHEMA_FILE=

# ── mail: SMTP + BullMQ mail queue (monolith, notifications-service) ────────────────────────
# Mailpit from docker compose (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (465); false = STARTTLS when offered
# SMTP_SECURE=false
# Refuse to send unless STARTTLS succeeds; default: on in production for a remote host unless SMTP_SECURE.
# SMTP_REQUIRE_TLS=
# Set both or neither
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="NestJS Boilerplate <no-reply@example.com>"
# Public web app URL for mail links (invitation accept page); https in production.
MAIL_APP_URL=http://localhost:3000
# SMTP_POOL=true
# SMTP_MAX_CONNECTIONS=5
# MAIL_QUEUE_CONCURRENCY=5
# LOCAL compose stack only (Mailpit): accept plaintext, the Mailpit host and example.com in production mode.
# SMTP_ALLOW_INSECURE=false

# ── storage: uploads to S3 or GCS (gateway, monolith) ───────────────────────────────────────
# s3 (RustFS locally) | gcs (fake-gcs-server locally)
STORAGE_DRIVER=s3
# Upload limits are the files namespace (domains/files/src/files.config.ts). 25 MiB:
# STORAGE_MAX_UPLOAD_BYTES=26214400
# Streamed uploads (POST /v1/files) in flight per process; more get 503 + Retry-After.
# Each one holds up to ~15 MiB of off-heap Buffers (S3 multipart: 3 × 5 MiB parts).
# STORAGE_MAX_CONCURRENT_UPLOADS=4
# Presigned URL lifetime (max 7 days)
# STORAGE_SIGNED_URL_TTL_SEC=900
S3_ENDPOINT=http://localhost:9000
# Host baked into presigned URLs (default = S3_ENDPOINT); must be reachable by the client
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# Required by RustFS/MinIO-style endpoints (no wildcard DNS)
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=uploads
GCS_PROJECT_ID=local-project
GCS_BUCKET=uploads
# A non-googleapis.com host = emulator mode; real GCS: https://storage.googleapis.com
GCS_API_ENDPOINT=http://localhost:4443
# Host baked into GCS signed URLs (an emulator browsers reach under another name):
# GCS_PUBLIC_ENDPOINT=
# Service-account key file; unset = Application Default Credentials
# GCS_KEY_FILE=
# LOCAL compose stack only: accept the RustFS / fake-gcs emulator endpoints in production mode.
# STORAGE_ALLOW_INSECURE=false

# ── stripe: Checkout + webhooks (monolith, billing-service) ─────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys (sk_/rk_ prefix enforced);
# webhook secret from `stripe listen --forward-to localhost:3000/v1/billing/webhooks/stripe`.
# Unset = dev placeholders (sk_test_placeholder / whsec_placeholder), which NODE_ENV=production
# rejects. docker compose passes these two through to the containers when set (otherwise it uses
# its own compose-local fallbacks), so only uncomment them with real TEST values.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
# STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
# STRIPE_MAX_NETWORK_RETRIES=2
# STRIPE_TIMEOUT_MS=20000
# LOCAL compose stack only: accept http://localhost Checkout redirect URLs in production mode.
# STRIPE_ALLOW_LOCAL_REDIRECTS=false

# ── ledger: Stripe money postings to the immudb ledger (monolith, billing-service) ─────────
# Off by default: webhooks still record receipts and payment transitions but write no
# billing.ledger-posting.v1 outbox row. Enabling it later backfills through one explicit-window
# reconciliation run.
# LEDGER_ENABLED=false
# Hourly reconciliation window, in hours back from now (1-720)
# LEDGER_RECONCILE_LOOKBACK_HOURS=72
# Reconciliation R5: prove each hour (dual proof, and the state signature when
# IMMUDB_SERVER_SIGNING_PUBLIC_KEY or _FILE is set) that immudb extends the trusted state kept in Postgres,
# advance it and verify the new entries against their receipts.
# LEDGER_VERIFY=false
# Production refuses LEDGER_ENABLED=true without LEDGER_VERIFY=true and
# IMMUDB_SERVER_SIGNING_PUBLIC_KEY (or _FILE); this is the only opt-out (an unverified ledger).
# LEDGER_ALLOW_UNVERIFIED=false

# ── ai: LLM calls through OpenRouter (monolith) ─────────────────────────────────────────────
# Off by default: nothing calls OpenRouter and the AI routes answer 503 AI_DISABLED.
# AI_ENABLED=false
# Required when AI_ENABLED=true (https://openrouter.ai/keys); a placeholder is refused in production
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model used when a request names none (<vendor>/<model>[:variant])
# AI_DEFAULT_MODEL=openai/gpt-4o-mini
# Other models a request may name (CSV); anything else is 422 AI_MODEL_NOT_ALLOWED
# AI_ALLOWED_MODELS=
# OpenRouter fallback routing, tried in order when the requested model fails (allowed models only)
# AI_FALLBACK_MODELS=
# AI_MAX_OUTPUT_TOKENS=1024
# Deadline of one call (a whole stream included); the upstream call is aborted
# AI_REQUEST_TIMEOUT_MS=60000
# SDK retries of retryable failures only (429, 5xx, network)
# AI_MAX_RETRIES=2
# Message text one call may send, history included
# AI_MAX_INPUT_CHARS=32000
# History window: last N messages within an approximate token budget (characters / 4)
# AI_HISTORY_MAX_MESSAGES=20
# AI_HISTORY_MAX_TOKENS=8000
# Tool-calling steps per request
# AI_MAX_TOOL_STEPS=3

# ── aiRateLimit: the ai.chat policy, one charge per model call (monolith) ───────────────────
# Messages sent per user per window
# AI_CHAT_LIMIT=20
# AI_CHAT_TTL_MS=60000
# Messages sent per tenant per window, shared by every member
# AI_CHAT_TENANT_LIMIT=200
# AI_CHAT_TENANT_TTL_MS=60000

# ── Node.js runtime (read by Node itself) ───────────────────────────────────────────────────
# libuv pool (Argon2id, zlib, fs, dns.lookup); default 4. Keep it <= the CPUs available to the
# process: more busy threads than CPUs starve the event loop (measured, see docs/DOCKER.md).
# UV_THREADPOOL_SIZE=4
# NODE_OPTIONS=--max-old-space-size=512

# ═════════════════════════════════════════════════════════════════════════════════════════════
# docker compose ONLY (interpolation in docker-compose.yml; ignored by the apps). See docs/DOCKER.md.
# ═════════════════════════════════════════════════════════════════════════════════════════════
# Profiles to start without --profile flags (monolith | microservices, observability, logs, tools, loadtest)
# COMPOSE_PROFILES=
# App image build target: runtime (distroless) | runtime-alpine (shell) | dev (TS sources, no build)
# APP_TARGET=runtime
# TAG=local
# App container settings
# DOCKER_NODE_ENV=production
# DOCKER_LOG_LEVEL=info
# false = send traces to Jaeger (also start the observability profile)
# DOCKER_OTEL_SDK_DISABLED=true
# DOCKER_OTEL_SAMPLER_RATIO=1.0
# DOCKER_DOCS_ENABLED=true
# DOCKER_STORAGE_DRIVER=s3
# LOCAL ONLY: trust X-Forwarded-For from private-network peers (k6 models many clients); in
# production list only your load balancer's IPs/CIDRs (TRUST_PROXY=true is rejected there)
# DOCKER_TRUST_PROXY=uniquelocal
# Compose project name (prefix of containers/volumes/networks; Alloy only ships this project's
# logs). Defaults to `name:` in docker-compose.yml; -p <name> overrides it too.
# COMPOSE_PROJECT_NAME=boilerplate
# Non-default local secrets (NODE_ENV=production rejects the dev defaults); >= 32 chars
# DOCKER_JWT_ACCESS_SECRET=compose-local-access-secret-not-for-production-0001
# DOCKER_JWT_REFRESH_SECRET=compose-local-refresh-secret-not-for-production-0002
# Infra credentials (change DATABASE_URL / S3_* above to match for host apps; the three database
# roles and their passwords live in docker/postgres/init/02-roles.sql and docker/pgbouncer/userlist.txt)
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=app
# RUSTFS_ACCESS_KEY=rustfsadmin
# RUSTFS_SECRET_KEY=rustfsadmin
# Browser origins allowed by RustFS's S3 listener (presigned uploads from a frontend); comma-separated
# DOCKER_S3_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CASSANDRA_DC=datacenter1
# CASSANDRA_HEAP=512M
# KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# Host ports (all bound to 127.0.0.1)
# API_HOST_PORT=3000
# POSTGRES_HOST_PORT=5432
# PGBOUNCER_HOST_PORT=6432
# REDIS_HOST_PORT=6379
# CASSANDRA_HOST_PORT=9042
# KAFKA_HOST_PORT=9094
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# S3_HOST_PORT=9000
# S3_CONSOLE_HOST_PORT=9001
# GCS_HOST_PORT=4443
# IMMUDB_HOST_PORT=3322
# IDENTITY_GRPC_HOST_PORT=50051
# NOTIFICATIONS_GRPC_HOST_PORT=50052
# BILLING_GRPC_HOST_PORT=50053
# KAFKA_UI_HOST_PORT=8080
# JAEGER_UI_HOST_PORT=16686
# OTLP_GRPC_HOST_PORT=4317
# OTLP_HTTP_HOST_PORT=4318
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3300
# LOKI_HOST_PORT=3100
# ALLOY_HOST_PORT=12345
# K6_DASHBOARD_HOST_PORT=5665
# k6 (docker compose --profile loadtest run --rm k6)
# K6_BASE_URL=http://api:3000
# K6_RATE=5
# K6_READ_RATE=0
# K6_DURATION=1m
# K6_P95_MS=250
# K6_MAX_ERROR_RATE=0.01
# uid:gid the k6 container runs as, so it can write docker/k6/reports on Linux hosts (bash's UID is
# not exported to compose): K6_UID=$(id -u) K6_GID=$(id -g) bun run loadtest
# K6_UID=1000
# K6_GID=1000
# Empty = no Prometheus remote write (when the observability profile is not running)
# K6_OUT=experimental-prometheus-rw
