# Isolated docker compose project for the B1 checkpoint runs (persistence-7, platform-8).
# It never touches the default `boilerplate` project's volumes, and its host ports never collide
# with the developer's own containers (Postgres on 5432, Redis on 6379, ...). Load it into the
# shell before any docker compose / bun run docker:* command:
#   set -a; . docs/superpowers/plans/2026-10-12-b1-ownership-moves/artifacts/checkpoint/checkpoint.env; set +a
# `TAG=b1` keeps the built images (boilerplate/<app>:b1) apart from the developer's :local ones.
COMPOSE_PROJECT_NAME=b1-verify
TAG=b1
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
CASSANDRA_HOST_PORT=19042
KAFKA_HOST_PORT=19094
MAILPIT_SMTP_HOST_PORT=11025
MAILPIT_UI_HOST_PORT=18025
S3_HOST_PORT=19000
S3_CONSOLE_HOST_PORT=19001
GCS_HOST_PORT=14443
API_HOST_PORT=13000
IDENTITY_GRPC_HOST_PORT=15051
NOTIFICATIONS_GRPC_HOST_PORT=15052
BILLING_GRPC_HOST_PORT=15053
KAFKA_UI_HOST_PORT=18080
JAEGER_UI_HOST_PORT=16687
OTLP_GRPC_HOST_PORT=14317
OTLP_HTTP_HOST_PORT=14318
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13300
# Host-side tools (bun run db:migrate, psql) reach the isolated Postgres, never the root .env's.
DATABASE_URL=postgres://app:app@127.0.0.1:15432/app
