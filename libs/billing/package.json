{
  "name": "@app/billing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Billing bounded context: Stripe Checkout sessions, idempotent signed webhooks, payments ledger (Drizzle) and the billing.payment-succeeded.v1 integration event - REST, GraphQL and gRPC presentation over CQRS.",
  "exports": {
    ".": {
      "@app/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project billing",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@app/auth": "workspace:*",
    "@app/common": "workspace:*",
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/database": "workspace:*",
    "@app/graphql": "workspace:*",
    "@app/identity": "workspace:*",
    "@app/payments": "workspace:*",
    "@app/redis": "workspace:*",
    "@app/transport": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@nestjs-cls/transactional": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/websockets": "catalog:",
    "class-validator": "catalog:",
    "dataloader": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "lodash-es": "catalog:",
    "nestjs-cls": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "stripe": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@types/lodash-es": "catalog:",
    "fastify": "catalog:"
  }
}
