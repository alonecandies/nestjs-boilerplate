{
  "name": "@platform/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JWT access-token verification (passport-jwt, HS256, local), Redis access-token denylist, RBAC guards/decorators for HTTP, GraphQL and WebSocket, and a test-token signer (./testing).",
  "exports": {
    ".": {
      "@repo/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@repo/source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project auth",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@platform/common": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/redis": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "ioredis": "catalog:",
    "lodash-es": "catalog:",
    "nestjs-cls": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/passport-jwt": "catalog:"
  }
}
