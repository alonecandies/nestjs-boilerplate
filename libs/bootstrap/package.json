{
  "name": "@app/bootstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "App factories: Fastify-based Nest app (helmet, compression, CORS, versioning, graceful shutdown), listen, OpenAPI + Scalar docs, node:cluster supervision and process safety nets.",
  "exports": {
    ".": {
      "@app/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc --cli-config-file ../../swc.cli.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project bootstrap",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/config": "workspace:*",
    "@app/observability": "workspace:*",
    "@fastify/compress": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@scalar/nestjs-api-reference": "catalog:",
    "fastify": "catalog:",
    "lodash-es": "catalog:",
    "nestjs-pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/auth": "workspace:*",
    "@app/redis": "workspace:*",
    "@app/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@types/lodash-es": "catalog:"
  }
}
