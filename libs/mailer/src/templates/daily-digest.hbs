{{> header title="Your daily digest" preheader=(concat "You have " unreadCount " unread notifications.")}}
<h1 style="margin:0 0 16px;font-size:22px;color:#1f2933;">{{#if displayName}}{{displayName}}, here{{else}}Here{{/if}} is your daily digest</h1>
<p style="margin:0 0 20px;">You have <strong>{{unreadCount}}</strong> unread {{plural unreadCount "notification" "notifications"}}.</p>
{{#each items}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 12px;border:1px solid #e4e7eb;border-radius:6px;">
<tr><td style="padding:12px 16px;">
<div style="font-weight:600;color:#1f2933;">{{title}}</div>
<div style="margin:4px 0;color:#3e4c59;">{{body}}</div>
<div style="font-size:12px;color:#7b8794;">{{createdAt}}</div>
</td></tr>
</table>
{{else}}
<p style="margin:0 0 12px;color:#52606d;">Nothing new since yesterday.</p>
{{/each}}
{{#if appUrl}}{{> button url=appUrl label="Open your inbox"}}{{/if}}
{{> footer}}
