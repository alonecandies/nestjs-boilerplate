{{> header title="Payment receipt" preheader=(concat "We received your payment of " amount ".")}}
<h1 style="margin:0 0 16px;font-size:22px;color:#1f2933;">Payment received</h1>
<p style="margin:0 0 20px;">{{#if displayName}}Hi {{displayName}}, thanks{{else}}Thanks{{/if}} for your payment. Here is your receipt.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:14px;">
<tr><td style="padding:8px 0;border-bottom:1px solid #e4e7eb;color:#52606d;">Amount</td><td align="right" style="padding:8px 0;border-bottom:1px solid #e4e7eb;font-weight:600;">{{amount}}</td></tr>
{{#if description}}<tr><td style="padding:8px 0;border-bottom:1px solid #e4e7eb;color:#52606d;">Description</td><td align="right" style="padding:8px 0;border-bottom:1px solid #e4e7eb;">{{description}}</td></tr>{{/if}}
<tr><td style="padding:8px 0;border-bottom:1px solid #e4e7eb;color:#52606d;">Paid at</td><td align="right" style="padding:8px 0;border-bottom:1px solid #e4e7eb;">{{paidAt}}</td></tr>
<tr><td style="padding:8px 0;color:#52606d;">Reference</td><td align="right" style="padding:8px 0;font-family:Menlo,Consolas,monospace;font-size:12px;">{{paymentId}}</td></tr>
</table>
{{#if appUrl}}{{> button url=appUrl label="View your payments"}}{{/if}}
<p style="margin:16px 0 0;color:#52606d;">Keep this email for your records.</p>
{{> footer}}
